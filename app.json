{
  "id": "nl.rvginkel.knoppen",
  "version": "1.1.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "brandColor": "#00AEEF",
  "platforms": [
    "local"
  ],
  "runtime": "nodejs",
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getButtons": {
      "method": "GET",
      "path": "/buttons"
    },
    "createButton": {
      "method": "POST",
      "path": "/buttons"
    },
    "updateButton": {
      "method": "PUT",
      "path": "/buttons"
    },
    "removeButton": {
      "method": "DELETE",
      "path": "/buttons"
    },
    "getBooleanVariables": {
      "method": "GET",
      "path": "/boolean-variables"
    }
  },
  "author": {
    "name": "Rene van Ginkel",
    "email": "temp200@xs4all.nl"
  },
  "support": "mailto:temp200@xs4all.nl",
  "name": {
    "en": "Dashboard Buttons",
    "nl": "Dashboard Knoppen"
  },
  "description": {
    "en": "Create dashboard buttons and use them in a Flow.",
    "nl": "Maak dashboard knoppen en gebruik deze in een Flow."
  },
  "category": "tools",
  "tags": {
    "en": [
      "dashboard",
      "buttons",
      "flow",
      "control"
    ],
    "nl": [
      "dashboard",
      "knoppen",
      "flow",
      "bediening"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "widgets": {
    "buttons": {
      "id": "buttons",
      "name": {
        "en": "Button",
        "nl": "Knop"
      },
      "description": {
        "en": "Create dashboard buttons and use them in a Flow.",
        "nl": "Maak dashboard knoppen en gebruik deze in een Flow."
      },
      "transparent": true,
      "api": {
        "getBooleanValue": {
          "method": "GET",
          "path": "/boolean"
        },
        "getButtons": {
          "method": "GET",
          "path": "/buttons"
        },
        "triggerActionButton": {
          "method": "POST",
          "path": "/trigger-action-button"
        },
        "triggerBooleanButton": {
          "method": "POST",
          "path": "/trigger-boolean-button"
        }
      },
      "settings": [
        {
          "id": "button1",
          "type": "autocomplete",
          "title": {
            "en": "Position 1",
            "nl": "Positie 1"
          }
        },
        {
          "id": "button2",
          "type": "autocomplete",
          "title": {
            "en": "Position 2",
            "nl": "Positie 2"
          }
        },
        {
          "id": "button3",
          "type": "autocomplete",
          "title": {
            "en": "Position 3",
            "nl": "Positie 3"
          }
        },
        {
          "id": "button4",
          "type": "autocomplete",
          "title": {
            "en": "Position 4",
            "nl": "Positie 4"
          }
        },
        {
          "id": "button5",
          "type": "autocomplete",
          "title": {
            "en": "Position 5",
            "nl": "Positie 5"
          }
        },
        {
          "id": "button6",
          "type": "autocomplete",
          "title": {
            "en": "Position 6",
            "nl": "Positie 6"
          }
        },
        {
          "id": "button7",
          "type": "autocomplete",
          "title": {
            "en": "Position 7",
            "nl": "Positie 7"
          }
        },
        {
          "id": "button8",
          "type": "autocomplete",
          "title": {
            "en": "Position 8",
            "nl": "Positie 8"
          }
        },
        {
          "id": "button9",
          "type": "autocomplete",
          "title": {
            "en": "Position 9",
            "nl": "Positie 9"
          }
        },
        {
          "id": "button10",
          "type": "autocomplete",
          "title": {
            "en": "Position 10",
            "nl": "Positie 10"
          }
        },
        {
          "id": "button11",
          "type": "autocomplete",
          "title": {
            "en": "Position 11",
            "nl": "Positie 11"
          }
        },
        {
          "id": "button12",
          "type": "autocomplete",
          "title": {
            "en": "Position 12",
            "nl": "Positie 12"
          }
        }
      ],
      "height": 70
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Action button [[button]] is pressed",
          "nl": "Actieknop [[button]] is ingedrukt"
        },
        "titleFormatted": {
          "en": "Action button [[button]] is pressed",
          "nl": "Actieknop [[button]] is ingedrukt"
        },
        "hint": {
          "en": "The Action value configured for the button is available in this Flow as a text tag.",
          "nl": "De ingestelde Actiewaarde bij de knop is in deze Flow beschikbaar als teksttag."
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop"
            }
          }
        ],
        "tokens": [
          {
            "name": "actionValue",
            "type": "string",
            "title": {
              "en": "Action value",
              "nl": "Actiewaarde"
            }
          }
        ],
        "id": "action_button-pressed"
      },
      {
        "title": {
          "en": "Yes/No button [[button]] is pressed",
          "nl": "Ja/Nee-knop [[button]] is ingedrukt"
        },
        "titleFormatted": {
          "en": "Yes/No button [[button]] is pressed",
          "nl": "Ja/Nee-knop [[button]] is ingedrukt"
        },
        "hint": {
          "en": "The 'Button Yes/No' tag contains the new status of the button. Use this tag in the Flow to change the linked Yes/No variable using a Logic Flow card.",
          "nl": "De tag 'Knop Ja/Nee' bevat de nieuwe status van de knop. Gebruik deze tag in de Flow om via een Logic Flow-kaart de gekoppelde Ja/Nee-variabele te wijzigen."
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop"
            }
          }
        ],
        "tokens": [
          {
            "name": "buttonValue",
            "type": "boolean",
            "title": {
              "en": "Button Yes/No",
              "nl": "Knop Ja/Nee"
            }
          }
        ],
        "id": "boolean_button_pressed"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Enable or disable button",
          "nl": "Knop in- of uitschakelen"
        },
        "titleFormatted": {
          "en": "Set [[button]] to [[enabled]]",
          "nl": "Zet [[button]] op [[enabled]]"
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop"
            }
          },
          {
            "name": "enabled",
            "type": "dropdown",
            "title": {
              "en": "Status",
              "nl": "Status"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "Enabled",
                  "nl": "Ingeschakeld"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "Disabled",
                  "nl": "Uitgeschakeld"
                }
              }
            ]
          }
        ],
        "id": "set_button_enabled"
      },
      {
        "title": {
          "en": "Set permanent button color",
          "nl": "Stel permanente kleur van knop in"
        },
        "titleFormatted": {
          "en": "Set permanent color of [[button]] to [[enabled]] in [[color]]",
          "nl": "Stel permanente kleur van [[button]] [[enabled]] in [[color]]"
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop"
            }
          },
          {
            "name": "enabled",
            "type": "dropdown",
            "title": {
              "en": "Permanent color",
              "nl": "Permanente kleur"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "On",
                  "nl": "Aan"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "Off",
                  "nl": "Uit"
                }
              }
            ]
          },
          {
            "name": "color",
            "type": "color",
            "title": {
              "en": "Color",
              "nl": "Kleur"
            }
          }
        ],
        "id": "set_button_permanent_color"
      },
      {
        "title": {
          "en": "Start light loop around button",
          "nl": "Start lichtloop rond knop"
        },
        "titleFormatted": {
          "en": "Start light loop around [[button]] for [[duration]] seconds in [[color]]",
          "nl": "Start lichtloop rond [[button]] gedurende [[duration]] seconden in [[color]]"
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop"
            }
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration (seconds)",
              "nl": "Duur (seconden)"
            },
            "min": 1,
            "max": 15
          },
          {
            "name": "color",
            "type": "color",
            "title": {
              "en": "Color",
              "nl": "Kleur"
            }
          }
        ],
        "id": "start_button_lightloop"
      }
    ]
  }
}