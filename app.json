{
  "id": "nl.rvginkel.knoppen",
  "version": "1.2.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "brandColor": "#00AEEF",
  "platforms": [
    "local"
  ],
  "runtime": "nodejs",
  "permissions": [
    "homey:manager:api",
    "homey:app:net.i-dev.betterlogic"
  ],
  "api": {
    "getButtons": {
      "method": "GET",
      "path": "/buttons"
    },
    "createButton": {
      "method": "POST",
      "path": "/buttons"
    },
    "updateButton": {
      "method": "PUT",
      "path": "/buttons"
    },
    "removeButton": {
      "method": "DELETE",
      "path": "/buttons"
    },
    "getBooleanVariables": {
      "method": "GET",
      "path": "/boolean-variables"
    },
    "getBetterLogicAvailable": {
      "method": "GET",
      "path": "/betterlogic-available"
    },
    "getBetterLogicBooleanVariables": {
      "method": "GET",
      "path": "/betterlogic-boolean-variables"
    }
  },
  "author": {
    "name": "Rene van Ginkel",
    "email": "temp200@xs4all.nl"
  },
  "support": "mailto:temp200@xs4all.nl",
  "name": {
    "en": "Dashboard Buttons",
    "nl": "Dashboard Knoppen",
    "es": "Botones del Dashboard"
  },
  "description": {
    "en": "Create dashboard buttons and use them in a Flow.",
    "nl": "Maak dashboard knoppen en gebruik deze in een Flow.",
    "es": "Crea botones para el dashboard y úsalos en un Flow."
  },
  "category": "tools",
  "tags": {
    "en": [
      "dashboard",
      "button",
      "buttons",
      "flow",
      "control"
    ],
    "nl": [
      "dashboard",
      "knoppen",
      "knop",
      "flow",
      "bediening"
    ],
    "es": [
      "dashboard",
      "botón",
      "botones",
      "flow",
      "control"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "widgets": {
    "buttons": {
      "id": "buttons",
      "name": {
        "en": "Button",
        "nl": "Knop",
        "es": "Botón"
      },
      "description": {
        "en": "Create dashboard buttons and use them in a Flow.",
        "nl": "Maak dashboard knoppen en gebruik deze in een Flow.",
        "es": "Crea botones para el dashboard y úsalos en un Flow."
      },
      "transparent": true,
      "api": {
        "getBooleanValue": {
          "method": "GET",
          "path": "/boolean"
        },
        "getButtons": {
          "method": "GET",
          "path": "/buttons"
        },
        "getBetterLogicBooleanValue": {
          "method": "GET",
          "path": "/betterlogic-boolean"
        },
        "triggerActionButton": {
          "method": "POST",
          "path": "/trigger-action-button"
        },
        "triggerBooleanButton": {
          "method": "POST",
          "path": "/trigger-boolean-button"
        }
      },
      "settings": [
        {
          "id": "button1",
          "type": "autocomplete",
          "title": {
            "en": "Position 1",
            "nl": "Positie 1",
            "es": "Posición 1"
          }
        },
        {
          "id": "button2",
          "type": "autocomplete",
          "title": {
            "en": "Position 2",
            "nl": "Positie 2",
            "es": "Posición 2"
          }
        },
        {
          "id": "button3",
          "type": "autocomplete",
          "title": {
            "en": "Position 3",
            "nl": "Positie 3",
            "es": "Posición 3"
          }
        },
        {
          "id": "button4",
          "type": "autocomplete",
          "title": {
            "en": "Position 4",
            "nl": "Positie 4",
            "es": "Posición 4"
          }
        },
        {
          "id": "button5",
          "type": "autocomplete",
          "title": {
            "en": "Position 5",
            "nl": "Positie 5",
            "es": "Posición 5"
          }
        },
        {
          "id": "button6",
          "type": "autocomplete",
          "title": {
            "en": "Position 6",
            "nl": "Positie 6",
            "es": "Posición 6"
          }
        },
        {
          "id": "button7",
          "type": "autocomplete",
          "title": {
            "en": "Position 7",
            "nl": "Positie 7",
            "es": "Posición 7"
          }
        },
        {
          "id": "button8",
          "type": "autocomplete",
          "title": {
            "en": "Position 8",
            "nl": "Positie 8",
            "es": "Posición 8"
          }
        },
        {
          "id": "button9",
          "type": "autocomplete",
          "title": {
            "en": "Position 9",
            "nl": "Positie 9",
            "es": "Posición 9"
          }
        },
        {
          "id": "button10",
          "type": "autocomplete",
          "title": {
            "en": "Position 10",
            "nl": "Positie 10",
            "es": "Posición 10"
          }
        },
        {
          "id": "button11",
          "type": "autocomplete",
          "title": {
            "en": "Position 11",
            "nl": "Positie 11",
            "es": "Posición 11"
          }
        },
        {
          "id": "button12",
          "type": "autocomplete",
          "title": {
            "en": "Position 12",
            "nl": "Positie 12",
            "es": "Posición 12"
          }
        }
      ],
      "height": 70
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Action button [[button]] is pressed",
          "nl": "Actieknop [[button]] is ingedrukt",
          "es": "Se ha pulsado el botón de acción [[button]]"
        },
        "titleFormatted": {
          "en": "Action button [[button]] is pressed",
          "nl": "Actieknop [[button]] is ingedrukt",
          "es": "Se ha pulsado el botón de acción [[button]]"
        },
        "hint": {
          "en": "The Action value configured for the button is available in this Flow as a text tag.",
          "nl": "De ingestelde Actiewaarde bij de knop is in deze Flow beschikbaar als teksttag.",
          "es": "El valor de acción configurado para el botón está disponible en este Flow como etiqueta de texto."
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop",
              "es": "Botón"
            }
          }
        ],
        "tokens": [
          {
            "name": "actionValue",
            "type": "string",
            "title": {
              "en": "Action value",
              "nl": "Actiewaarde",
              "es": "Valor de acción"
            }
          }
        ],
        "id": "action_button-pressed"
      },
      {
        "title": {
          "en": "Yes/No button [[button]] is pressed",
          "nl": "Ja/Nee-knop [[button]] is ingedrukt",
          "es": "Se ha pulsado el botón Sí/No [[button]]"
        },
        "titleFormatted": {
          "en": "Yes/No button [[button]] is pressed",
          "nl": "Ja/Nee-knop [[button]] is ingedrukt",
          "es": "Se ha pulsado el botón Sí/No [[button]]"
        },
        "hint": {
          "en": "The 'Button Yes/No' tag contains the new status of the button. Use this tag in the Flow to change the linked Yes/No variable using a Logic Flow card.",
          "nl": "De tag 'Knop Ja/Nee' bevat de nieuwe status van de knop. Gebruik deze tag in de Flow om via een Logic Flow-kaart de gekoppelde Ja/Nee-variabele te wijzigen.",
          "es": "La etiqueta 'Botón Sí/No' contiene el nuevo estado del botón. Usa esta etiqueta en el Flow para cambiar la variable Sí/No vinculada mediante una tarjeta de Flow de Logic."
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop",
              "es": "Botón"
            }
          }
        ],
        "tokens": [
          {
            "name": "buttonValue",
            "type": "boolean",
            "title": {
              "en": "Button Yes/No",
              "nl": "Knop Ja/Nee",
              "es": "Botón Sí/No"
            }
          }
        ],
        "id": "boolean_button_pressed"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Set Yes/No status of button",
          "nl": "Stel Ja/Nee-status van knop in",
          "es": "Establecer estado Sí/No del botón"
        },
        "titleFormatted": {
          "en": "Set [[button]] to [[value]]",
          "nl": "Stel [[button]] in op [[value]]",
          "es": "Establecer [[button]] en [[value]]"
        },
        "hint": {
          "en": "Sets the Yes/No status of a button that uses 'Flow - no variable' as its status source.",
          "nl": "Stelt de Ja/Nee-status in van een knop die 'Flow - geen variabele' als statusbron gebruikt.",
          "es": "Establece el estado Sí/No de un botón que usa 'Flow - sin variable' como fuente de estado."
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "button",
            "title": {
              "en": "Button",
              "nl": "Knop",
              "es": "Botón"
            },
            "placeholder": {
              "en": "Select a button",
              "nl": "Selecteer een knop",
              "es": "Selecciona un botón"
            }
          },
          {
            "type": "dropdown",
            "name": "value",
            "title": {
              "en": "Status",
              "nl": "Status",
              "es": "Estado"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "Yes",
                  "nl": "Ja",
                  "es": "Sí"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "No",
                  "nl": "Nee",
                  "es": "No"
                }
              }
            ]
          }
        ],
        "id": "set_button_boolean_value"
      },
      {
        "title": {
          "en": "Enable or disable button",
          "nl": "Knop in- of uitschakelen",
          "es": "Activar o desactivar botón"
        },
        "titleFormatted": {
          "en": "Set [[button]] to [[enabled]]",
          "nl": "Zet [[button]] op [[enabled]]",
          "es": "Establecer [[button]] en [[enabled]]"
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop",
              "es": "Botón"
            }
          },
          {
            "name": "enabled",
            "type": "dropdown",
            "title": {
              "en": "Status",
              "nl": "Status",
              "es": "Estado"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "Enabled",
                  "nl": "Ingeschakeld",
                  "es": "Activado"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "Disabled",
                  "nl": "Uitgeschakeld",
                  "es": "Desactivado"
                }
              }
            ]
          }
        ],
        "id": "set_button_enabled"
      },
      {
        "title": {
          "en": "Set permanent button color",
          "nl": "Stel permanente kleur van knop in",
          "es": "Establecer color permanente del botón"
        },
        "titleFormatted": {
          "en": "Set permanent color of [[button]] to [[enabled]] in [[color]]",
          "nl": "Stel permanente kleur van [[button]] [[enabled]] in [[color]]",
          "es": "Establecer el color permanente de [[button]] en [[color]]: [[enabled]]"
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop",
              "es": "Botón"
            }
          },
          {
            "name": "enabled",
            "type": "dropdown",
            "title": {
              "en": "Permanent color",
              "nl": "Permanente kleur",
              "es": "Color permanente"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "On",
                  "nl": "Aan",
                  "es": "Activado"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "Off",
                  "nl": "Uit",
                  "es": "Desactivado"
                }
              }
            ]
          },
          {
            "name": "color",
            "type": "color",
            "title": {
              "en": "Color",
              "nl": "Kleur",
              "es": "Color"
            }
          }
        ],
        "id": "set_button_permanent_color"
      },
      {
        "title": {
          "en": "Start light loop around button",
          "nl": "Start lichtloop rond knop",
          "es": "Iniciar animación de luz alrededor del botón"
        },
        "titleFormatted": {
          "en": "Start light loop around [[button]] for [[duration]] seconds in [[color]]",
          "nl": "Start lichtloop rond [[button]] gedurende [[duration]] seconden in [[color]]",
          "es": "Iniciar animación de luz alrededor de [[button]] durante [[duration]] segundos en [[color]]"
        },
        "args": [
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "nl": "Knop",
              "es": "Botón"
            }
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration (seconds)",
              "nl": "Duur (seconden)",
              "es": "Duración (segundos)"
            },
            "min": 1,
            "max": 15
          },
          {
            "name": "color",
            "type": "color",
            "title": {
              "en": "Color",
              "nl": "Kleur",
              "es": "Color"
            }
          }
        ],
        "id": "start_button_lightloop"
      }
    ]
  }
}